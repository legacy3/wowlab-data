     "MAINHAND",
     "OFFHAND",
     "RANGED",
     "TABARD"
    ],
    "values": {
     "type": "object",
     "description": "One equipped item instance; identical to gearing.loadout.LoadoutEntry (the slot is the object key).",
     "properties": {
      "item_id": {
       "type": "integer",
       "class": "identity",
       "required": true,
       "description": "ItemSparse.ID"
      },
      "context": {
       "type": "integer",
       "class": "identity",
       "required": false,
       "description": "ItemContext (difficulty/source); default 0 = none. Carries the difficulty *inside* the loadout, so difficulty is never encounter state."
      },
      "bonus_list_ids": {
       "type": "array<integer>",
       "class": "identity",
       "required": false,
       "description": "explicit ItemBonusListIDs (upgrade steps, sockets, crafted-stat choices are all bonus lists)"
      },
      "gems": {
       "type": "array<integer|object>",
       "class": "identity",
       "required": false,
       "description": "gem item ids by socket index, or {socket_index, gem_item_id, bonus_list_ids}"
      },
      "enchant_ids": {
       "type": "array<integer>",
       "class": "identity",
       "required": false,
       "description": "SpellItemEnchantment ids (permanent enchants)"
      },
      "mythic_plus_keystone_level": {
       "type": "integer|null",
       "class": "identity",
       "required": false,
       "description": "keystone level for M+ contexts"
      },
      "pvp_tier": {
       "type": "integer|null",
       "class": "identity",
       "required": false,
       "description": "PvP tier for PvP contexts"
      },
      "label": {
       "type": "string|null",
       "class": "provenance",
       "required": false,
       "description": "free text"
      },
      "auto_bonus_lists": {
       "type": "boolean",
       "class": "identity",
       "required": false,
       "description": "let gearing derive the context bonus lists (default true)"
      }
     }
    }
   },
   "server_inputs": {
    "type": "object",
    "class": "server",
    "required": true,
    "description": "Trinity-authored world-database facts, always explicit",
    "properties": {
     "base_stats": {
      "type": "object",
      "class": "server",
      "required": true,
      "properties": {
       "source": {
        "type": "string",
        "class": "server",
        "required": true,
        "description": "world-db-corpus | inline | unsupplied"
       },
       "path": {
        "type": "string|null",
        "class": "server",
        "required": false,
        "description": "corpus path (world-db-corpus)"
       },
       "class_level_stats": {
        "type": "object",
        "class": "server",
        "required": false,
        "description": "inline: {class: {level: [str,agi,sta,int,spi]}}"
       },
       "race_stat_modifiers": {
        "type": "object",
        "class": "server",
        "required": false,
        "description": "inline: {race: [str,agi,sta,int,spi]}"
       },
       "provenance": {
        "type": "string|null",
        "class": "server",
        "required": false,
        "description": "where inline values came from"
       },
       "fill_rule": {
        "type": "string|null",
        "class": "server",
        "required": false,
        "description": "none (default) | trinity: explicit opt-in to ObjectMgr::LoadPlayerInfo's gap fill (ObjectMgr.cpp:4349-4356, a copy of the previous level's cell) for world-db-corpus base stats; filled cells are Trinity authoring, never Retail truth"
       }
      }
     }
    }
   },
   "controlled_units": {
    "type": "object",
    "class": "hook",
    "required": false,
    "description": "extensible; each key is an object owned by the controlled-unit research (hunter pet family/spec/creature, warlock active demon ...)"
   },
   "options": {
    "type": "object",
    "class": "identity",
    "required": false,
    "properties": {
     "enable_pvp_talents": {
      "type": "boolean",
      "class": "identity",
      "required": false,
      "description": "acquire pvp_traits (default false)"
     },
     "include_class_skill_lines": {
      "type": "boolean",
      "class": "identity",
      "required": false,
      "description": "list the non-race-gated default-skill spells (class line, weapon / armour / language / generic lines) in derived.spells (default true); reporting only -- they always feed the dual-wield / titan-grip / proficiency / armour-spec checks"
     },
     "rng": {
      "type": "null",
      "class": "provenance",
      "required": false,
      "description": "reserved; preparation needs no RNG identity"
     }
    }
   },
   "observations": {
    "type": "array<object>",
    "class": "provenance",
    "required": false,
    "items": {
     "type": "object",
     "description": "An externally observed value attached to a derived-state path.  Designed so a future Retail client / WASM oracle can be compared without changing the format.",
     "properties": {
      "observer": {
       "type": "string",
       "class": "provenance",
       "required": true,
       "description": "who observed: retail-client | trinity-probe | core | addon | other"
      },
      "build": {
       "type": "string",
       "class": "provenance",
       "required": true,
       "description": "client/server build the observation was taken on"
      },
      "captured_at": {
       "type": "string|null",
       "class": "provenance",
       "required": false,
       "description": "ISO-8601 timestamp"
      },
      "path": {
       "type": "string",
       "class": "provenance",
       "required": true,
       "description": "JSON pointer into the compiled output, e.g. /derived/stats/value/Strength"
      },
      "value": {
       "type": "any",
       "class": "provenance",
       "required": true,
       "description": "observed value"
      },
      "units": {
       "type": "string|null",
       "class": "provenance",
       "required": false,
       "description": "points | percent | fraction | ms | seconds | count | id"
      },
      "precision": {
       "type": "number|null",
       "class": "provenance",
       "required": false,
       "description": "absolute tolerance used by the comparison (default exact)"
      },
      "notes": {
       "type": "string|null",
       "class": "provenance",
       "required": false,
       "description": "free text"
      }
     }
    }
   }
  }
 }
