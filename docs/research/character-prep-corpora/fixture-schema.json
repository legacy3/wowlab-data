      "type": "string|null",
      "class": "provenance",
      "required": false,
      "description": "ISO-8601 capture time"
     },
     "external_ids": {
      "type": "object",
      "class": "provenance",
      "required": false,
      "description": "opaque ids in the source system"
     },
     "notes": {
      "type": "array<string>",
      "class": "provenance",
      "required": false,
      "description": "free text"
     },
     "generator": {
      "type": "string|null",
      "class": "provenance",
      "required": false,
      "description": "tool that produced the fixture"
     }
    }
   },
   "identity": {
    "type": "object",
    "class": "identity",
    "required": true,
    "properties": {
     "race_id": {
      "type": "integer",
      "class": "identity",
      "required": true,
      "description": "ChrRaces.ID"
     },
     "class_id": {
      "type": "integer",
      "class": "identity",
      "required": true,
      "description": "ChrClasses.ID"
     },
     "spec_id": {
      "type": "integer",
      "class": "identity",
      "required": true,
      "description": "ChrSpecialization.ID"
     },
     "level": {
      "type": "integer",
      "class": "identity",
      "required": true,
      "description": "player level (1..MaxLevel)"
     }
    }
   },
   "traits": {
    "type": "object",
    "class": "identity",
    "required": true,
    "properties": {
     "entries": {
      "type": "array<object>",
      "class": "identity",
      "required": true,
      "description": "selected (TraitNodeEntryID, rank) pairs; the tree and node are derived",
      "items": {
       "node_entry_id": {
        "type": "integer",
        "class": "identity",
        "required": true,
        "description": "TraitNodeEntry.ID"
       },
       "rank": {
        "type": "integer",
        "class": "identity",
        "required": true,
        "description": "purchased ranks (1..MaxRanks)"
       }
      }
     },
     "hero_subtree_id": {
      "type": "integer|null",
      "class": "identity",
      "required": false,
      "description": "TraitSubTree.ID of the active hero tree"
     },
     "loadout_string": {
      "type": "string|null",
      "class": "provenance",
      "required": false,
      "description": "the addon/Blizzard export string, kept opaque; never decoded here"
     }
    }
   },
   "pvp_traits": {
    "type": "array<object>",
    "class": "identity",
    "required": false,
    "description": "optional PvP talents; only acquired when options.enable_pvp_talents",
    "items": {
     "pvp_talent_id": {
      "type": "integer",
      "class": "identity",
      "required": true,
      "description": "PvpTalent.ID"
     },
     "slot": {
      "type": "integer",
      "class": "identity",
      "required": true,
      "description": "0..MAX_PVP_TALENT_SLOTS-1"
     }
    }
   },
   "learned_spells": {
    "type": "array<integer>",
    "class": "identity",
    "required": false,
    "description": "SpellIDs the character learned through a path no automatic grant reproduces (trainer, quest, item, SkillLineAbility AcquireMethod 0 'Learned', e.g. 296087 Dual Wield for an Arms warrior); character_spell rows restored by Player::_LoadSpells (Player.cpp:18609) -> AddSpell. Spells every character of the identity gets automatically are derived, never listed here"
   },
   "equipment": {
    "type": "object",
    "class": "identity",
    "required": true,
    "description": "slot name (Trinity EquipmentSlots) -> equipment entry",
