 "policy": [
  {
   "consumer": "Spell.cpp:9306-9351",
   "evidence": "trinity-consumer",
   "rule": "CheckTarget -> referer is a Unit -> target not a totem -> caster.IsValidAssistTarget (skipped for corpses) -> referer.IsInPartyWith(target)",
   "subject": "TARGET_CHECK_PARTY"
  },
  {
   "consumer": "Spell.cpp:9358-9368",
   "evidence": "trinity-consumer",
   "rule": "as PARTY with referer.IsInRaidWith",
   "subject": "TARGET_CHECK_RAID"
  },
  {
   "consumer": "Spell.cpp:9352-9357",
   "evidence": "trinity-consumer",
   "rule": "referer is a Unit -> referer.GetClass() == unit.GetClass() (the REFERER's class: for 61 the explicit target) -> falls through to RAID",
   "subject": "TARGET_CHECK_RAID_CLASS"
  },
  {
   "consumer": "Spell.cpp:9369-9374; TemporarySummon.cpp:37-45",
   "evidence": "trinity-consumer",
   "rule": "unit.IsSummon() && SummonerGUID == m_caster (no totem exclusion, no assist test, referer unused); pets/guardians/totems/minions are TempSummons",
   "subject": "TARGET_CHECK_SUMMONED"
  },
  {
   "consumer": "Spell.cpp:9312-9319",
   "evidence": "trinity-consumer",
   "rule": "a corpse stands for its owner player (FindPlayer, map-independent); no owner -> rejected; assist test skipped",
   "subject": "corpse targets"
  },
  {
   "consumer": "Unit.cpp:12184-12218; Player.cpp:2070-2080; Group.cpp:994-1003; Creature.h:235",
   "evidence": "trinity-consumer",
   "rule": "self -> true; u = GetCharmerOrOwnerOrSelf (ONE level) of both; equal -> true; both players -> IsInSameGroupWith (same Group and same subgroup) / IsInSameRaidWith (same Group); player vs creature -> creature TREAT_AS_RAID_UNIT flag; creature vs creature -> same faction; else false",
   "subject": "Unit::IsInPartyWith / IsInRaidWith"
  },
  {
   "consumer": "Player.cpp:2070-2080",
   "evidence": "trinity-consumer",
   "rule": "party = raid = self + units whose charmer-or-owner is the player (pets, guardians, totems -- totems then excluded by the check) + TREAT_AS_RAID_UNIT creatures; Player.GetGroup() is m_group only",
   "subject": "ungrouped player"
  },
  {
   "consumer": "Spell.cpp:1328-1378, 9306-9374; Unit.cpp:12190-12192",
   "evidence": "trinity-consumer",
   "rule": "m_caster is the pet; referer is the pet for CASTER/SRC/DEST/NEARBY selectors, so membership resolves through the pet's owner (one level); assist validity is from the pet; SUMMONED compares with the pet's GUID (units the pet summoned)",
   "subject": "pet caster"
  },
  {
   "consumer": "Object.cpp:1610-1624; Unit.cpp:12184-12218",
   "evidence": "trinity-consumer",
   "rule": "a guardian owned by a pet resolves to the pet (a creature): vs players only TREAT_AS_RAID_UNIT applies -> not in party/raid with the player; TARGET_UNIT_MASTER from it is the pet",
   "subject": "owner-of-owner"
  },
  {
   "consumer": "Spell.cpp:1442-1452",
   "evidence": "trinity-consumer",
   "rule": "controlled units are ordinary candidates of the searched list: they count toward MaxAffectedTargets / RandomResize like players (no player priority in the generic area path)",
   "subject": "caps"
  },
  {
   "consumer": "Spell.cpp:2150-2151, 754",
   "evidence": "trinity-consumer",
   "rule": "restricts the grid searcher to players and corpses (removes pets/guardians/totems) and is a grouping key",
   "subject": "PlayersOnly effect attribute"
  },
  {
   "consumer": "Spell.cpp:1807-1830; SpellInfo.cpp:176-193, 2530-2562",
   "evidence": "trinity-consumer",
   "rule": "DEFAULT category: the recipient is the explicit target without any membership filter at selection time; membership is enforced only through the explicit target mask (TARGET_FLAG_UNIT_PARTY/RAID/PASSENGER) in CheckExplicitTarget, where ALLY short-circuits and membership is tested before IsValidAssistTarget",
   "subject": "TARGET_UNIT_TARGET_PARTY(35) / TARGET_UNIT_TARGET_RAID(57) / TARGET_UNIT_TARGET_PASSENGER(95)"
  },
  {
   "consumer": "Spell.cpp:1393-1402, 1328-1378",
   "evidence": "trinity-consumer",
   "rule": "no explicit unit -> nothing; caster not a Unit or !caster.IsInRaidWith(target) -> exactly the explicit target (no area/assist/cap filtering beyond AddUnitTarget); else RAID area search centred on the explicit target with referer = explicit target (membership from the target's raid), target not force-included",
   "subject": "TARGET_UNIT_TARGET_ALLY_OR_RAID(118)"
  },
  {
   "consumer": "Spell.cpp:1403-1407, 1442-1452",
   "evidence": "trinity-consumer",
   "rule": "caster pushed first (no check), then SUMMONED area search around the caster; list then goes through script hook and RandomResize like any area list (the caster can be dropped by the cap)",
   "subject": "TARGET_UNIT_CASTER_AND_SUMMONS(120)"
  },
  {
   "consumer": "Spell.cpp:1742-1806; Unit.cpp:6230-6243, 6275-6296; TemporarySummon.cpp:499-502",
   "evidence": "trinity-consumer",
   "rule": "MASTER = GetCharmerOrOwner (charmer first, one level); PET = PetGUID if UNIT_MASK_GUARDIAN (pets and SummonProperties Control==PET guardians only); SUMMONER = summoner unit of a TempSummon caster; all added with checkIfValid=true; CASTER without CheckTarget",
   "subject": "TARGET_UNIT_MASTER / PET / SUMMONER / OWN_CRITTER / VEHICLE"
  },
  {
   "consumer": "Spell.cpp:474-521, 1041, 2476, 8235",
   "evidence": "trinity-consumer",
   "rule": "m_caster = charmer/owner iff SPELL_ATTR6_ORIGINATE_FROM_CONTROLLER; selection, checks and referers use m_caster; m_originalCaster (explicit GUID else m_caster) is used for channel selectors (1041-1054), hit results (2476) and GO LOS (8235)",
   "subject": "m_caster vs original caster"
  },
  {
   "consumer": "SpellAuraEffects.cpp:5583-5605; SpellInfo.cpp:1717-1751; SpellDefines.h:527",
   "evidence": "trinity-consumer",
   "rule": "HandlePeriodicTriggerSpellAuraTick casts from the aura CASTER when NeedsToBeTriggeredByCaster (explicit unit target needed, or channeled trigger with non-caster unit targets), else from the HOLDER; explicit target = holder; OriginalCaster not set -> equals the casting unit",
   "subject": "periodic trigger"
  },
  {
   "consumer": "Spell.cpp:640-662",
   "evidence": "trinity-consumer",
   "rule": "player caster -> its selection if CheckExplicitTarget passes; creature (pet) caster -> its victim when the mask wants ENEMY/UNIT; else self unless the mask needs ENEMY/DEAD/MINIPET/PASSENGER",
   "subject": "triggered cast without unit target"
  }
 ],
