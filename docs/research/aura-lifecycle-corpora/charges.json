 "rules": [
  {
   "counterexamples": [
    "spell_proc Charges 0 does not disable charges (SpellMgr.cpp:1576)"
   ],
   "definition": "m_procCharges = uint8(CalcMaxCharges) at construction: spell_proc Charges (a 0 row falls back to DB2 ProcCharges at load) else DB2 ProcCharges, then ProcCharges spell mods; m_isUsingCharges = charges != 0",
   "evidence": [
    "trinity-consumer",
    "trinity-probe",
    "differential"
   ],
   "id": "AL-R-C-21",
   "name": "initial-charges",
   "population": "all providers",
   "status": "holds-on-census"
  },
  {
   "counterexamples": [
    "Stormkeeper 191634: charges consumed by its script only"
   ],
   "definition": "Only an aura with a SpellProcEntry can lose charges to procs (PrepareProcChargeDrop, then removal at 0 in ConsumeProcCharges); spell-mod charge auras are dropped through the same proc path",
   "evidence": [
    "trinity-consumer"
   ],
   "id": "AL-R-C-22",
   "name": "proc-drop-needs-entry",
   "population": "charges-without-proc-entry 398 all / 28 player never drop by the default proc path",
   "status": "holds-on-census"
  },
  {
   "counterexamples": [
    "12 of them also have charges > 0: dormant charges still gate procs (IsUsingCharges && !GetCharges)"
   ],
   "definition": "PROC_ATTR_USE_STACKS_FOR_CHARGES (spell_proc) turns proc consumption into ModStackAmount(-1) and leaves m_procCharges untouched",
   "evidence": [
    "world-db-fact",
    "trinity-consumer",
    "trinity-probe"
   ],
   "id": "AL-R-C-23",
   "name": "use-stacks-for-charges",
   "population": "34 all / 11 player",
   "status": "holds-on-census"
  },
  {
   "counterexamples": [
    "AURA_UNIQUE capacity-0 auras keep spent charges"
   ],
   "definition": "Every refreshing ModStackAmount resets charges to the live CalcMaxCharges; non-refreshing reapplications keep them",
   "evidence": [
    "trinity-consumer",
    "trinity-probe"
   ],
   "id": "AL-R-C-24",
   "name": "charges-reset-on-refresh",
   "population": "all providers with charges (1,355 all)",
   "status": "holds-on-census"
  },
  {
   "counterexamples": [
    "ATTR7_DISPEL_REMOVES_CHARGES auras without charges are never offered to dispel"
   ],
   "definition": "ModCharges is a no-op unless IsUsingCharges; it caps only increases and removes at <= 0",
   "evidence": [
    "trinity-consumer",
    "trinity-probe"
   ],
   "id": "AL-R-C-25",
   "name": "mod-charges-inert-without-charges",
   "population": "all providers",
   "status": "holds-on-census"
  },
  {
   "counterexamples": [
    "Wall of Steel 203261: Intervene 147833 0 -> 2 charges",
    "Arcane Dream 353360: Presence of Mind 205025 2 -> 0 (no charges) and 198154 0 -> uint32(-2) (UB) -> 254"
   ],
   "definition": "Whether an aura uses charges is decided by the live CalcMaxCharges at construction (and each refresh), so ProcCharges spell mods can create charges on a DB2 charge-less aura or erase them",
   "evidence": [
    "db2-fact",
    "trinity-consumer",
    "structural-inference"
   ],
   "id": "AL-R-C-26",
   "name": "charges-exist-by-live-mods",
   "population": "11 ProcCharges modifier rows (see proc_charge_modifiers)",
   "status": "holds-on-census"
  }
 ],
