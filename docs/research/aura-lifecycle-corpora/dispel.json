 "rules": [
  {
   "counterexamples": [],
   "definition": "Candidates are the target's owned auras applied on it, not passive, dispel-mask hit, application positivity != relation (xor reflect), CalcDispelChance > 0 and >0 stacks (or charges under ATTR7); one weight per aura.",
   "evidence": [
    "trinity-consumer",
    "trinity-probe",
    "differential"
   ],
   "id": "AL-R-E-10",
   "name": "dispel-selection",
   "population": "dispellable providers (census.*.dispellable)",
   "status": "trinity-only"
  },
  {
   "counterexamples": [],
   "definition": "Each of the effect-value attempts draws urand(0, remaining-1) then irand(0,99) (int32 roll_chance); a failed roll consumes the attempt and leaves the candidate; each call consumes one rand32 word on libstdc++ 13 (including urand(0,0) and a 100 % chance) plus one more per Lemire rejection (word w redrawn when (w*n) mod 2^32 < 2^32 mod n; e.g. w = 0 for irand(0,99)).",
   "evidence": [
    "trinity-probe",
    "differential"
   ],
   "id": "AL-R-E-11",
   "name": "dispel-attempt-draws",
   "population": "raw-38 dispellers (census.*.dispeller_effects)",
   "status": "trinity-only"
  },
  {
   "counterexamples": [],
   "definition": "A success removes one stack (or one charge under ATTR7_DISPEL_REMOVES_CHARGES), all of them under ATTR1_DISPEL_ALL_STACKS; OnDispel runs before and AfterDispel after the mutation; mode ENEMY_SPELL. All removals are deferred until every attempt has been rolled (SpellEffects.cpp:2216).",
   "evidence": [
    "trinity-consumer",
    "trinity-probe"
   ],
   "id": "AL-R-E-12",
   "name": "dispel-removal-unit",
   "population": "dispellable providers",
   "status": "trinity-only"
  },
  {
   "counterexamples": [],
   "definition": "DispelType 11 (Trinity enum name DESPEL_OLD_UNUSED) is carried by current auras (all 12 player-population ones are bleeds by name: Rupture 1943, Rip 1079, Rake 155722, Garrote 703, ...) and dispelled by misc-11 effects (Cauterizing Flame 374251); Trinity's mask arithmetic (1 << 11) handles it, the DISPEL_ALL mask does not include it.",
   "evidence": [
    "db2-fact",
    "trinity-consumer",
    "structural-inference"
   ],
   "id": "AL-R-E-14",
   "name": "dispel-type-11-is-a-live-family",
   "population": "census.*.dispellable dispel_type:OLD_UNUSED (all 818, player 12)",
   "status": "holds-on-census"
  },
  {
   "counterexamples": [],
   "definition": "Mechanic dispel draws irand(0,99) for every owned aura applied on the target (passive and positive ones included) before testing the mechanic mask, then removes whole auras with ENEMY_SPELL and no dispel hooks.",
   "evidence": [
    "trinity-consumer"
   ],
   "id": "AL-R-E-13",
